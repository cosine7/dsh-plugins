{
  "name": "@cosine/dsh-plugins",
  "private": true,
  "description": "按个人工作流定制并持续维护的 DeepSeek Harness 插件集合",
  "type": "module",
  "scripts": {
    "prepare": "simple-git-hooks",
    "build": "pnpm -r run build",
    "dev": "pnpm --parallel -r run dev",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "test:watch": "pnpm --parallel -r run test:watch",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run fmt:check && pnpm run test && pnpm run build"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2007",
    "simple-git-hooks": "^2.14.0",
    "tsdown": "^0.23.7",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm check",
    "preserveUnused": true
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.22.2",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=24.9.0"
  },
  "packageManager": "pnpm@12.18.0"
}
